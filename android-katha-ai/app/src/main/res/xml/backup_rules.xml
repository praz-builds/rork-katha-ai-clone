<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 (API 30) and below. allowBackup is already false, so this file is
  belt-and-braces: if backup is ever re-enabled, nothing is eligible by default.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
