{
  "expo": {
    "name": "Katha AI",
    "slug": "katha-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "kathaai",
    "assetBundlePatterns": [
      "assets/**/*"
    ],
    "plugins": [
      "@sentry/react-native/expo",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon-notification.png",
          "color": "#FF6B1A"
        }
      ],
      "expo-tracking-transparency",
      "expo-updates",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Katha uses a photo you choose as your profile picture, or as a style reference for a character illustration (the character's face is always original art).",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "updates": {
      "url": "https://u.expo.dev/UPDATE_PROJECT_ID",
      "fallbackToCacheTimeout": 10000
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.katha.createstories",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "ai.katha.createstories",
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "com.google.android.gms.permission.AD_ID"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-android-foreground.png",
        "backgroundColor": "#FF6B1A"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "sentryDsn": "",
      "eas": {
        "projectId": ""
      }
    }
  }
}
