{
  "expo": {
    "name": "Katha AI",
    "slug": "katha-ai",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "kathaai",
    "assetBundlePatterns": [
      "assets/**/*"
    ],
    "plugins": [
      "@sentry/react-native/expo",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#FF6B1A"
        }
      ],
      "expo-tracking-transparency",
      "react-native-adapty",
      [
        "expo-updates",
        {
          "username": "katha-ai"
        }
      ]
    ],
    "updates": {
      "url": "https://u.expo.dev/UPDATE_PROJECT_ID",
      "fallbackToCacheTimeout": 10000
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.katha.createstories"
    },
    "android": {
      "package": "ai.katha.createstories",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FF6B1A"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "supabaseUrl": "https://iafeuxgoiknncgyjmugd.supabase.co",
      "supabaseAnonKey": "",
      "sentryDsn": "",
      "posthogApiKey": "",
      "posthogHost": "https://us.i.posthog.com",
      "eas": {
        "projectId": ""
      }
    }
  }
}
