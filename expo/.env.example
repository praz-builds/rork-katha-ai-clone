# Katha AI — Expo client environment template. Committed; contains no secrets.
# Copy to `expo/.env` and fill in. `.env` is gitignored.
#
# Only EXPO_PUBLIC_* variables reach the app: Expo inlines them into the bundle
# at build time, so every value here is readable by anyone who downloads the
# app. Put nothing here that is not already public.
#
# The service role key, and every provider key (OpenAI, OpenRouter, RunPod,
# Gemini), are server-side only and live in backend/.env plus Supabase secrets.
# The client calls an Edge Function; the function holds the credential.

EXPO_PUBLIC_SUPABASE_URL=https://iafeuxgoiknncgyjmugd.supabase.co
# Public by design. Row Level Security, not secrecy, is what protects the data.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# local | development | production
EXPO_PUBLIC_APP_ENV=local

# Note: Sentry DSN and the EAS project id are read from `expo.extra` in
# app.json, not from this file. Adapty was removed in the RevenueCat migration;
# the RevenueCat public SDK key lives in src/lib/revenuecat.ts.
