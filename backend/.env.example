# Katha AI — backend environment template. Committed; contains no secrets.
# Copy to `backend/.env` and fill in. `.env` is gitignored (backend/.gitignore).
#
# `backend/.env` is the single local source of truth for backend credentials.
# Every agent session should read from it rather than asking for keys again.
# Supabase secrets are the runtime store for deployed Edge Functions; this file
# is its local mirror, used by scripts/*.py and by `supabase secrets set`.
#
# Nothing in this file may ever appear in expo/ or in a client bundle.

# --- Supabase: project iafeuxgoiknncgyjmugd (Seoul, ap-northeast-2) ---
SUPABASE_URL=https://iafeuxgoiknncgyjmugd.supabase.co
# Public by design; ships in the app. RLS is what protects the data.
SUPABASE_ANON_KEY=
# Bypasses RLS entirely. Server-side only. If it reaches a repository or a
# build, rotate it in the Supabase dashboard immediately.
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM providers, in the order _shared/llm.ts tries them ---
# 1. Gemini 3.1 Pro Preview
GEMINI_API_KEY=
# 2. pinned google/gemini-2.5-flash, and 4. the named free-model tier.
#    Also the image fallback chain in _shared/image.ts.
OPENROUTER_API_KEY=
# 3. gpt-5.6-luna -> gpt-5-mini -> gpt-4o-mini, AND gpt-image-1 covers.
#    Shared between story and image generation, so they share a blast radius.
OPENAI_API_KEY=

# --- Other services ---
RUNPOD_API_KEY=                     # audio narration, minimax-speech-02-hd
REVENUECAT_WEBHOOK_SECRET=
SUBSCRIPTION_GRANT_CRON_SECRET=

# Comma-separated exact-origin allowlist for browser clients. Native clients
# send no Origin header and are unaffected.
ALLOWED_ORIGINS=http://localhost:8090,http://localhost:8081
