node_modules
.env
.expo
.rork
.agents/
.DS_Store
*.log
**/supabase/.temp/
SESSION_HANDOFF.md

# Credential material — never commit (security gate: AGENTS.md)
.env.*
!.env.example
*.pem
*.p12
*.jks
*.keystore
google-services.json
GoogleService-Info.plist

# Agent working artifacts (research memos, design specs) — local only
research/
design/

# Exception: reviewed genre-craft research memos live in the repo (docs/research/)
!docs/research/
docs/research/*
!docs/research/*.md

# Exception: signed design handoff specs live in the repo (docs/design/)
!docs/design/
docs/design/*
!docs/design/*.md

# Harness worktrees for sub-agents
.claude/worktrees/

# Continuity harness output (backend/originals/continuity-eval.ts).
# The written stories are megabytes of regenerable prose; the audits are the
# evidence and are small, so the audits stay tracked and the bodies do not.
backend/originals/bench/before/
backend/originals/bench/after/

# Preview worktree lock (scripts/preview.sh)
.preview-lock/

# Python bytecode
__pycache__/
*.pyc
